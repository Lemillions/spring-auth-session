# Database Configuration
DATABASE_URL=postgres://postgres:password@localhost:5432/session_auth
# or use individual components:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=session_auth
# DB_USER=postgres
# DB_PASSWORD=password

# Redis Configuration
REDIS_URL=redis://localhost:6379
# or use individual components:
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Server Configuration
PORT=8080

# Logging
RUST_LOG=spring_auth_session=debug,tower_http=debug